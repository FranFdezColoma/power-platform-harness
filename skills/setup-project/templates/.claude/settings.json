      "PowerShell(pac auth who *)",
      "PowerShell(pac org list *)",
      "PowerShell(pac env list *)",
      "PowerShell(pac solution list *)",
      "PowerShell(pac org fetch *)",
      "PowerShell(pac env fetch *)",
