      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "PowerShell(pac solution delete *)",
      "PowerShell(pac solution upgrade *)",
      "PowerShell(pac connection delete *)",
      "PowerShell(pac admin delete *)",
      "PowerShell(pac admin reset *)",
      "PowerShell(pac admin restore *)",
      "PowerShell(pac admin copy *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git branch -D *)",
      "mcp__*__delete_record",
      "mcp__*__delete_table",
      "mcp__*__delete_skill"
    ]
