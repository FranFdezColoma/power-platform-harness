# This repository only. skills/setup-project/templates/.gitignore is template content shipped into
# every project: it is tracked, never ignored, and nothing here applies to it.
.claude/settings.local.json
.build-cache/

# Build output Visual Studio or npm may leave inside the templates: never template content.
skills/setup-project/templates/**/bin/
skills/setup-project/templates/**/obj/
skills/setup-project/templates/**/node_modules/
